{
  "name": "evglab-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env PORT=3001 node --max-http-header-size=524288 ./node_modules/next/dist/bin/next dev --webpack --port 3001",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev",
    "build": "next build",
    "start": "node --max-http-header-size=524288 ./node_modules/next/dist/bin/next start",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "check:instagram-oauth": "node scripts/check-instagram-oauth-env.mjs",
    "setup:owner": "node scripts/setup-owner-account.mjs",
    "billing:preflight": "node scripts/billing-atomic-rollout.mjs preflight",
    "billing:sync-webhook": "node scripts/billing-atomic-rollout.mjs sync-stripe-webhook",
    "billing:sync-webhook:live": "node scripts/billing-atomic-rollout.mjs sync-stripe-webhook --live",
    "billing:migrate": "node scripts/billing-atomic-rollout.mjs apply-migration --confirm",
    "openai:rotation-env:init": "node scripts/init-rotation-env.mjs",
    "openai:rotate-image-key": "node scripts/rotate-openai-image-key.mjs",
    "openai:rotate-image-key:dry-run": "node scripts/rotate-openai-image-key.mjs --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "^16.3.5",
    "openai": "^6.37.0",
    "playwright": "^1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.4",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
