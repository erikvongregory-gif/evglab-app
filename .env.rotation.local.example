# Kopie als .env.rotation.local anlegen:
#   npm run openai:rotation-env:init
#
# Nur fuer das Rotator-Script (npm run openai:rotate-image-key*).
# Diese Werte gehoeren NICHT in Vercel — nur lokal oder als GitHub Secrets.

# --- OpenAI Admin (Org-Admin-Key, nicht der Bild-Key) ---
# https://platform.openai.com/settings/organization/admin-keys
# Neu anlegen mit Permissions = All (nicht nachtraeglich auf All stellen).
OPENAI_ADMIN_KEY=

# Project-ID des dedizierten BrewAI-Bild-Projects
# https://platform.openai.com/settings/organization/projects
OPENAI_PROJECT_ID=

# Modell fuer Smoke-Test waehrend Rotation (Standard: gpt-image-2.5-sunburst)
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# --- Vercel API (Rotator schreibt Env + loest Deploy aus) ---
# Token: https://vercel.com/account/tokens — Scope: Full Account
VERCEL_TOKEN=

# BrewAI Production-Project (app.brewai.de)
VERCEL_PROJECT_ID=prj_Z1xSKcaDBst674hDsXmmQezzP2qU

# Team-Slug/ID — nur noetig bei Team-Account; bei Personal Account leer lassen
# VERCEL_ORG_ID=team_...

# Deploy Hook: Vercel → app.brewai → Settings → Git → Deploy Hooks → Production
VERCEL_DEPLOY_HOOK_URL=

# Minuten Wartezeit, bevor der alte Service-Account geloescht wird (Default: 20)
# ROTATION_GRACE_MINUTES=20
