# Kopie als .env.local anlegen und Werte eintragen.
# Dev-Server nach Änderungen neu starten.

# --- Stripe (Checkout / Abo) ---
# Test: https://dashboard.stripe.com/test/apikeys
# Live: https://dashboard.stripe.com/acct_1TJanRRojElHlMEe/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Preis-IDs (Fallbacks im Code — optional überschreiben)
STRIPE_PRICE_START_MONTHLY=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_START_YEARLY=price_...
STRIPE_PRICE_GROWTH_YEARLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TOKENS_500=price_...
STRIPE_PRICE_TOKENS_2000=price_...

# false = Kleinunternehmer §19 UStG (keine Stripe Tax) — Standard ohne explizites STRIPE_ENABLE_AUTOMATIC_TAX=true
STRIPE_ENABLE_AUTOMATIC_TAX=false

# --- Anthropic (Prompt-Generierung / Markenanalyse) ---
# Optional — Standard: claude-sonnet-4-6 mit Fallbacks
# ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Lokal: http://localhost:3001 (Port wie npm run dev). In Vercel: https://app.evglab.com
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_SITE_URL=https://evglab.com
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=true
NEXT_PUBLIC_LOGIN_WAITLIST_ENABLED=0
AUTH_INVITE_ONLY=false
TOKEN_STATE_SECRET=
