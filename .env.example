# Kopie als .env.local anlegen und Werte eintragen.
# Dev-Server nach Änderungen neu starten.

# --- Stripe (Checkout / Abo) ---
# Test: https://dashboard.stripe.com/test/apikeys
# Live: https://dashboard.stripe.com/acct_1TJanRRojElHlMEe/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional fuer Live-Webhook-Sync: npm run billing:sync-webhook:live
# STRIPE_LIVE_SECRET_KEY=sk_live_...

# Preis-IDs (Fallbacks im Code — optional überschreiben)
STRIPE_PRICE_START_MONTHLY=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_START_YEARLY=price_...
STRIPE_PRICE_GROWTH_YEARLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TOKENS_500=price_...
STRIPE_PRICE_TOKENS_2000=price_...

# false = Kleinunternehmer §19 UStG (keine Stripe Tax) — Standard ohne explizites STRIPE_ENABLE_AUTOMATIC_TAX=true
STRIPE_ENABLE_AUTOMATIC_TAX=false

# Markenprofil Website-Scan: Headless-Chromium umgeht Cookie-Banner + Altersgates (Standard: an)
# BRAND_INTAKE_BROWSER=0  # nur plain fetch (ohne JS)

# --- Anthropic (Prompt-Generierung / Markenanalyse) ---
# Optional — Standard: claude-sonnet-4-6 mit Fallbacks
# ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# --- Bildgenerierung (OpenAI Images, gpt-image-2.5-sunburst) ---
# Bilder werden direkt ueber die OpenAI Images API erzeugt und in Supabase Storage abgelegt.
# Final-Default: gpt-image-2.5-sunburst. Preview spaeter: gpt-image-2.5-flare.
# Nur der scoped Project-Key — kein Admin-Key. Rotation: scripts/rotate-openai-image-key.mjs
OPENAI_IMAGE_API_KEY=
# Legacy-Fallback (Migration); nach Umstellung entfernen:
# OPENAI_API_KEY=
# Optional — Standard: gpt-image-2.5-sunburst
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Bildqualitaet/-tempo: low (~20s) | medium (~40s, Standard) | high (~120s, sehr langsam)
# OPENAI_IMAGE_QUALITY=medium
# Spiegel fuer die Studio-Kostenvorschau im Browser (muss zu OPENAI_IMAGE_QUALITY passen):
# NEXT_PUBLIC_OPENAI_IMAGE_QUALITY=medium

# --- OpenAI Key-Rotation (NICHT in Vercel — nur Rotator lokal oder GitHub Actions) ---
# Vorlage: npm run openai:rotation-env:init  →  .env.rotation.local
# Siehe .env.rotation.local.example

# --- KI-Videos (Seedance via BytePlus ModelArk) ---
# Primärweg für /videos-erstellen (catalog-driven Studio-Logik).
ARK_API_KEY=
# ARK_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# ARK_ASSET_BASE_URL=https://ark.ap-southeast-1.byteplusapi.com
# Optional Token-Override (sonst Berechnung aus resolution/duration/audio):
# KIE_SEEDANCE_TOKEN_COST=90
# Videos-Seite in Production: NEXT_PUBLIC_VIDEOS_CREATE_ENABLED=true
# NEXT_PUBLIC_VIDEOS_CREATE_ENABLED=true

# --- Legacy: Seedance via Kie (nicht Primärweg) ---
KIE_API_KEY=
# KIE_API_BASE_URL=https://api.kie.ai
# KIE_SEEDANCE_MODEL=bytedance/seedance-2

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional fuer npm run billing:migrate (Postgres Direct Connection aus Supabase Dashboard)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Optional — Standard: generated-images (oeffentlicher Storage-Bucket fuer fertige Bilder)
# SUPABASE_GENERATED_IMAGES_BUCKET=generated-images

# --- App / Branding (BrewAI) ---
# Lokal: http://localhost:3001 (Port wie npm run dev). In Vercel Production: https://app.brewai.de
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3001
# Marketing-Site (Alias: NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_MARKETING_SITE_URL=https://brewai.de
# NEXT_PUBLIC_SITE_URL=https://brewai.de
NEXT_PUBLIC_SITE_NAME=BrewAI
NEXT_PUBLIC_PRODUCT_NAME=BrewAI
# Shared Cookies zwischen brewai.de und app.brewai.de (ohne führenden Punkt)
NEXT_PUBLIC_COOKIE_DOMAIN=brewai.de
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=true
# Lokal/Dev: 0 = Login offen (Dashboard entwickeln). Soft-Launch Production: ungesetzt oder 1.
# Go-live Production: off setzen (nicht 0 — 0 wurde in Vercel als Login missverstanden).
NEXT_PUBLIC_LOGIN_WAITLIST_ENABLED=0
# Betreiber-Bypass fuer Production-Warteliste (Server-only, nicht NEXT_PUBLIC):
# LOGIN_WAITLIST_BYPASS_SECRET=mindestens-8-zeichen
# URL nach Deploy: https://app.brewai.de/auth/operator-access?token=<secret>
# Alternativ Admin-Login: /admin/anmelden?next=/inhalte-erstellen
# Videos Erstellen (Seedance 2) — erst true setzen, wenn Feature live gehen soll
NEXT_PUBLIC_VIDEOS_CREATE_ENABLED=false
AUTH_INVITE_ONLY=false
TOKEN_STATE_SECRET=

# --- Zwei-Faktor-Authentifizierung (Pflicht fuer alle Konten) ---
# HMAC-Schluessel fuer 2FA-Cookies, min. 32 Zeichen (Fallback: NEXTAUTH_SECRET)
ADMIN_2FA_SECRET=
# Versand der Sicherheitscodes (Resend). Ohne diese Werte kommt niemand mehr rein.
RESEND_API_KEY=
# Absender muss bei resend.com/domains verifiziert sein (Ziel: brewai.de).
ADMIN_2FA_FROM_EMAIL=noreply@brewai.de
RESEND_FROM_EMAIL=noreply@brewai.de
# Fallback wenn brewai.de DNS noch nicht verifiziert ist
RESEND_FALLBACK_FROM_EMAIL=noreply@evglab.com
# Nur lokal (NODE_ENV=development): physische Zustellung aller Resend-Mails
# (2FA, Passwort-Reset, …) an diese Inbox umleiten. Logische Auth-Identität
# bleibt die echte User-E-Mail. In Production wird die Variable ignoriert.
# RESEND_DEV_FORWARD_TO=you@example.com

# --- Betreiber-Konto (unbegrenzte Tokens, kein Stripe-Abo noetig) ---
# Kommagetrennte Liste. Alternativ user_metadata.role = "owner" in Supabase setzen.
OWNER_EMAILS=admin@brewai.de
# Recovery-Code fuer das Betreiber-Konto (min. 8 Zeichen). Ersetzt den E-Mail-Code,
# falls die Owner-Adresse keinen Mailempfang hat. Bitte lang und zufaellig waehlen.
OWNER_2FA_BACKUP_CODE=

# --- Manuell in Dashboards setzen (nicht nur Env) ---
# Supabase Auth → Site URL: https://app.brewai.de
# Supabase Auth → Redirect URLs: https://app.brewai.de/** , http://localhost:3001/**
# Stripe Webhook: https://app.brewai.de/api/stripe/webhook
# Meta Instagram OAuth Redirect: https://app.brewai.de/api/brand/instagram/callback
# Resend: brewai.de in resend.com/domains + Netcup-DNS (DKIM/SPF); Fallback noreply@evglab.com

